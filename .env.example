# FalkorDB: local Docker (defaults below) OR a hosted instance (FalkorDB Cloud etc.) - no Docker needed for that:
# copy host / port / username / password from the cloud console and set FALKORDB_SSL=1 if it uses TLS.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=0
KAIROS_USER=arjun
KAIROS_TZ=Asia/Kolkata

# ---- LLM -------------------------------------------------------------------------
# auto       = OpenRouter when key+model are set and reachable, offline rule planner otherwise (recommended)
# openrouter = same as auto (rules still take over when the network/API fails)
# rules      = never call an LLM
KAIROS_LLM=auto
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models that supports TOOL CALLING (filter: "tools").
# Pick a strong model for the agent loop, e.g. an Anthropic Claude Sonnet/Haiku, OpenAI GPT or Google Gemini model.
OPENROUTER_MODEL=
# Optional cheaper/faster model for reading unknown notifications (defaults to OPENROUTER_MODEL)
OPENROUTER_EXTRACT_MODEL=
# Optional comma-separated backups; OpenRouter tries them in order if the main model fails
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KAIROS_LLM_TIMEOUT=20
# Check the setup with:  kairos llm-check

# ---- Notification triage -----------------------------------------------------------
# Every live notification is judged: importance 0-3 and "does it fulfil an open request?"
# auto = LLM (OPENROUTER_EXTRACT_MODEL) when available, rules otherwise | rules | off
# Note: in auto mode notification text is sent to OpenRouter.
KAIROS_TRIAGE=auto
KAIROS_TRIAGE_MAX_PER_MIN=20
# Alert without being asked when importance >= this (3 = only truly urgent things)
KAIROS_TRIAGE_NOTIFY_MIN=3

# ---- Live device status ---------------------------------------------------------------
# Device agents send a snapshot (open apps, foreground window, battery, network...) this often (0 = off)
KAIROS_STATUS_INTERVAL=120

# ---- Hybrid memory ----------------------------------------------------------------------
# 1 = local sentence-transformers embeddings for "search by meaning" (first run downloads ~130 MB model).
# Without the package it silently falls back to full-text search.
KAIROS_EMBEDDINGS=1

# ---- Integrations (all optional; empty = off) ---------------------------------------------
KAIROS_USER_NAME=Arjun Mehta
# How devices reach the hub over HTTP (file handoff links). Use the PC's LAN IP for a real phone.
KAIROS_HUB_PUBLIC_URL=http://localhost:8000
# Where handoff files are kept (default ~/.kairos)
KAIROS_DATA_DIR=

# Telegram: create a bot with @BotFather, paste the token; message the bot once and it replies with your chat id,
# then put that id here (only these chats can talk to KAIROS).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Calendar: comma-separated ICS URLs (Google "Secret address in iCal format", Outlook "Publish calendar"),
# local .ics paths, or "demo" for two generated meetings (prep pack fires ~1 min after start).
KAIROS_CALENDAR_URLS=demo
KAIROS_CALENDAR_INTERVAL=600

# Email over IMAP (read-only, messages are never marked read). Use an app password.
KAIROS_IMAP_HOST=
KAIROS_IMAP_PORT=993
KAIROS_IMAP_USER=
KAIROS_IMAP_PASSWORD=
KAIROS_IMAP_FOLDER=INBOX
KAIROS_IMAP_INTERVAL=120

# MCP plugins: path to plugins.json (default: plugins.json in the repo root; see plugins.example.json)
KAIROS_PLUGINS_FILE=

# Shared family memory: a second graph every family member's KAIROS points at, e.g. kairos:family
KAIROS_FAMILY_GRAPH=

# ---- Read-only web access (search + read pages) -------------------------------------------
# auto = real browser via Playwright if installed (pip install playwright), else plain HTTP | playwright | http | off
KAIROS_WEB=auto
# duckduckgo (default, no API key) | bing
KAIROS_WEB_ENGINE=duckduckgo
# Browser to drive: chrome (your installed Chrome, fresh empty profile) | msedge | empty = Playwright's Chromium
# (for the bundled one run: playwright install chromium)
KAIROS_WEB_CHANNEL=chrome
# 0 = show the browser window while it searches (good for demos)
KAIROS_WEB_HEADLESS=1
KAIROS_WEB_TIMEOUT=20
KAIROS_WEB_MAX_CHARS=6000
# Extra CA bundle if your network intercepts HTTPS with its own certificate (the OS store is already trusted)
KAIROS_CA_BUNDLE=
KAIROS_HUB_URL=ws://localhost:8000
KAIROS_DEVICE_TOKEN=change-me
# delete_path can only touch files inside this folder (default: ~/kairos_sandbox)
KAIROS_SANDBOX=
# 1 = the hub plays devices that aren't connected (fake downloads etc.) so the dashboard demo works without hardware
KAIROS_SIMULATE_DEVICES=1

# ---- Chat log + nightly memory digest -------------------------------------------------------
# 1 = save each day's conversation to <KAIROS_DATA_DIR>/chatlog/YYYY-MM-DD.txt (restores chats after a restart)
KAIROS_CHATLOG=1
# digested logs older than this many days are deleted
KAIROS_CHATLOG_DAYS=30
# auto = small model if configured, else rules | rules | off
KAIROS_DIGEST=auto
# a small, cheap OpenRouter model that files each day's chat into memory (default: OPENROUTER_EXTRACT_MODEL)
KAIROS_DIGEST_MODEL=
# yesterday's chat is digested after this local hour
KAIROS_DIGEST_HOUR=3

# ---- Voice: speech-to-text on the hub (dashboard mic, desktop pet) ------------------------------
# faster-whisper model: tiny.en | base.en | small.en | ... or a local folder (first use downloads it)
KAIROS_STT_MODEL=base.en
# cpu | cuda
KAIROS_STT_DEVICE=cpu
# en, or empty to auto-detect (use a multilingual model such as "small")
KAIROS_STT_LANGUAGE=en
# desktop pet colour theme: slate | classic | mint | peach
KAIROS_PET_SKIN=slate
